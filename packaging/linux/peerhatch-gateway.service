[Unit]
Description=PeerHatch Gateway
After=network.target

[Service]
Type=simple
User=peerhatch
Group=peerhatch
StateDirectory=peerhatch
StateDirectoryMode=0700
WorkingDirectory=/var/lib/peerhatch
RuntimeDirectory=peerhatch
RuntimeDirectoryMode=0750
UMask=0077
ExecStartPre=/usr/bin/systemd-tmpfiles --create /usr/local/lib/tmpfiles.d/peerhatch.conf
ExecStartPre=/usr/local/bin/peerhatch identity /etc/peerhatch/device.key
ExecStart=/usr/local/bin/peerhatch-gateway --config /etc/peerhatch/node.toml --key /etc/peerhatch/device.key --ipc /run/peerhatch/gateway.sock
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
