[Unit]
Description=Build and update the Linux and Windows paxri development apps
After=network-online.target

[Service]
WorkingDirectory=%h/paxri
EnvironmentFile=-%h/.config/paxri/dev-watch.env
Environment=PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -u %h/paxri/scripts/sync-windows.py --watch --dev
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
