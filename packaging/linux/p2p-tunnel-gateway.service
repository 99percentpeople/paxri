[Unit]
Description=P2P Tunnel Gateway
After=network.target

[Service]
Type=simple
User=p2p-tunnel
Group=p2p-tunnel
StateDirectory=p2p-tunnel
StateDirectoryMode=0700
WorkingDirectory=/var/lib/p2p-tunnel
RuntimeDirectory=p2p-tunnel
RuntimeDirectoryMode=0750
UMask=0027
ExecStart=/usr/local/libexec/p2p-tunnel/start-gateway /etc/p2p-tunnel --ipc /run/p2p-tunnel/gateway.sock
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
