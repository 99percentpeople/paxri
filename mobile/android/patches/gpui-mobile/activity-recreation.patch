+/// Release the window and its dispatcher while their native thread still exists.
+pub fn shutdown_platform() {
+    if let Some(platform) = NATIVE_PLATFORM.take() {
+        // Dropping the text system wakes its missing-glyph listener. Queue that
+        // wake first, then dispose its runnable on this thread after the sender
+        // has released the channel lock.
+        let dispatcher = platform.foreground_executor();
+        drop(platform);
+        dispatcher.shutdown();
+    }
+    let mut current = CURRENT_APP.lock();
+    if !NATIVE_APP.with(|slot| slot.get() == current.as_ref()) {
+        return;
+    }
