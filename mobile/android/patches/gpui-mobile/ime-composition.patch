+    // InputConnectionWrapper forwards the attributed overloads directly to the
+    // editor. Include them in the same batch and session checks as legacy IMEs.
+    @android.annotation.TargetApi(33)
+    private static class AttributedEdits extends InputConnectionWrapper {
+        AttributedEdits(InputConnection target) { super(target, false); }
+
+        @Override public boolean setComposingText(CharSequence text, int cursor, TextAttribute attr) {
+            if (!beginBatchEdit()) return false;
+            try { return super.setComposingText(text, cursor, attr); }
+            finally { endBatchEdit(); }
+        }
+
+        @Override public boolean setComposingRegion(int start, int end, TextAttribute attr) {
+            if (!beginBatchEdit()) return false;
+            try { return super.setComposingRegion(start, end, attr); }
+            finally { endBatchEdit(); }
+        }
+
+        @Override public boolean commitText(CharSequence text, int cursor, TextAttribute attr) {
+            if (!beginBatchEdit()) return false;
+            try { return super.commitText(text, cursor, attr); }
+            finally { endBatchEdit(); }
+        }
+
+        @android.annotation.TargetApi(34)
+        @Override public boolean replaceText(int start, int end, CharSequence text, int cursor, TextAttribute attr) {
+            if (!beginBatchEdit()) return false;
+            try { return super.replaceText(start, end, text, cursor, attr); }
+            finally { endBatchEdit(); }
+        }
+    }
