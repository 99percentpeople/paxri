+    fn fallback_weight(&self, fb_id: FontId, family_name: &str, requested: Weight) -> Weight {
+        let mut closest: Option<Weight> = None;
+        for face in self.font_system.db().faces() {
+            if !face.families.iter().any(|(name, _)| name == family_name) {
+                continue;
+            }
+            if face.weight == requested {
+                return requested;
+            }
+            if closest.is_none_or(|best| {
+                face.weight.0.abs_diff(requested.0) < best.0.abs_diff(requested.0)
+            }) {
+                closest = Some(face.weight);
+            }
+        }
+        if let Some(axis) = self
+            .loaded_font(fb_id)
+            .font
+            .as_swash()
+            .variations()
+            .find_by_tag(swash::tag_from_bytes(b"wght"))
+        {
+            let w = requested.0 as f32;
+            if w >= axis.min_value() && w <= axis.max_value() {
+                return requested;
+            }
+        }
+        closest.unwrap_or(requested)
+    }
